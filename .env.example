# .env.example — copy to .env and fill in your values
# NEVER commit .env to git (it is in .gitignore)

# PostgreSQL connection string (Supabase / Neon / local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/student_va_hub?sslmode=require"

# Auth.js — generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-secret"

# Base URL of the app (no trailing slash)
AUTH_URL="http://localhost:3000"

