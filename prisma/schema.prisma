// Student VA-Hub – Prisma Schema
// All times stored as UTC DateTime on Task, TimeLog, BlockedDate, Notification.
// ClassSchedule and Availability use dayOfWeek + startMinutes/endMinutes
// (minutes from midnight, Asia/Manila local time) so the conflict detector
// can work without timezone conversion on the schedule side.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  CLIENT
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum StudentResponse {
  ACCEPTED
  RESCHEDULE_REQUESTED
}

enum TimeLogStatus {
  OPEN
  CLOSED
  APPROVED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  APPROVED
  PAID
}

enum LinkStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// User & Profile
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  studentProfile    StudentProfile?
  classSchedules    ClassSchedule[]
  availabilities    Availability[]
  blockedDates      BlockedDate[]
  inviteCodes       InviteCode[]       @relation("StudentInviteCodes")
  usedInviteCodes   InviteCode[]       @relation("ClientUsedInviteCodes")
  clientLinks       ClientStudentLink[] @relation("ClientLinks")
  studentLinks      ClientStudentLink[] @relation("StudentLinks")
  tasksAsClient     Task[]             @relation("ClientTasks")
  tasksAsStudent    Task[]             @relation("StudentTasks")
  timeLogs          TimeLog[]
  invoicesAsStudent Invoice[]          @relation("StudentInvoices")
  invoicesAsClient  Invoice[]          @relation("ClientInvoices")
  notifications     Notification[]

  @@index([email])
  @@index([role])
}

model StudentProfile {
  id              String @id @default(cuid())
  userId          String @unique
  school          String
  course          String
  year            Int
  maxHoursPerDay  Float  @default(4)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Schedule & Availability
// dayOfWeek: 0 = Sunday … 6 = Saturday
// startMinutes / endMinutes: minutes from midnight in Asia/Manila local time
//   e.g. 13:00 Manila = 780, 14:00 Manila = 840
// ---------------------------------------------------------------------------

model ClassSchedule {
  id           String @id @default(cuid())
  studentId    String
  subject      String
  dayOfWeek    Int    // 0-6
  startMinutes Int    // minutes from midnight, Manila
  endMinutes   Int    // minutes from midnight, Manila

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, dayOfWeek])
}

model Availability {
  id           String @id @default(cuid())
  studentId    String
  dayOfWeek    Int    // 0-6
  startMinutes Int    // minutes from midnight, Manila
  endMinutes   Int    // minutes from midnight, Manila

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Client-Student Link
// One client per student enforced by @@unique([studentId]) for v1.0
// ---------------------------------------------------------------------------

model ClientStudentLink {
  id          String     @id @default(cuid())
  clientId    String
  studentId   String
  hourlyRate  Float
  status      LinkStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  client  User @relation("ClientLinks",  fields: [clientId],  references: [id], onDelete: Cascade)
  student User @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId])          // one client per student in v1.0
  @@unique([clientId, studentId])
  @@index([clientId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Invite Codes
// ---------------------------------------------------------------------------

model InviteCode {
  id            String    @id @default(cuid())
  studentId     String
  code          String    @unique  // 8-char, no look-alike chars
  usedByClientId String?
  createdAt     DateTime  @default(now())

  student      User  @relation("StudentInviteCodes", fields: [studentId],      references: [id], onDelete: Cascade)
  usedByClient User? @relation("ClientUsedInviteCodes", fields: [usedByClientId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([code])
}

// ---------------------------------------------------------------------------
// Tasks – UTC DateTimes
// ---------------------------------------------------------------------------

model Task {
  id              String           @id @default(cuid())
  clientId        String
  studentId       String
  title           String
  description     String?
  startAt         DateTime         // UTC
  dueAt           DateTime         // UTC
  estHours        Float
  hoursWarning    Boolean          @default(false)
  status          TaskStatus       @default(TODO)
  studentResponse StudentResponse?
  rescheduleReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  client   User      @relation("ClientTasks",  fields: [clientId],  references: [id], onDelete: Cascade)
  student  User      @relation("StudentTasks", fields: [studentId], references: [id], onDelete: Cascade)
  timeLogs TimeLog[]

  @@index([clientId])
  @@index([studentId])
  @@index([studentId, status])
  @@index([startAt])
}

// ---------------------------------------------------------------------------
// Time Logs – UTC DateTimes, with correction/dispute fields
// ---------------------------------------------------------------------------

model TimeLog {
  id               String            @id @default(cuid())
  studentId        String
  taskId           String
  timeIn           DateTime          // UTC
  timeOut          DateTime?         // UTC; null while OPEN
  totalHours       Float?            // computed on Time Out
  status           TimeLogStatus     @default(OPEN)

  // Correction fields (v1.1 — columns exist in v1.0 schema per spec §5)
  correctionNote     String?
  requestedTimeOut   DateTime?         // UTC
  correctionStatus   CorrectionStatus?
  disputeReason      String?
  disputeResponse    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task    Task @relation(fields: [taskId],    references: [id], onDelete: Cascade)

  // Invoice relation
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([taskId])
  @@index([studentId, status])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------

model Invoice {
  id          String        @id @default(cuid())
  studentId   String
  clientId    String
  totalHours  Float
  rate        Float
  amount      Float
  status      InvoiceStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student  User      @relation("StudentInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  client   User      @relation("ClientInvoices",  fields: [clientId],  references: [id], onDelete: Cascade)
  timeLogs TimeLog[]

  @@index([studentId])
  @@index([clientId])
  @@index([studentId, status])
}

// ---------------------------------------------------------------------------
// Blocked Dates – UTC DateTimes
// ---------------------------------------------------------------------------

model BlockedDate {
  id        String   @id @default(cuid())
  studentId String
  dateStart DateTime // UTC
  dateEnd   DateTime // UTC
  reason    String?
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, dateStart])
}

// ---------------------------------------------------------------------------
// Notifications – UTC DateTimes
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // e.g. "TASK_ASSIGNED" | "HOURS_APPROVED" | "CONFLICT"
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
}

